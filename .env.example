# Local development only. Real secrets belong in .env (ignored by Git).
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Windows host URLs. Compose worker uses redis:6379 on its private network.
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_WORKER_CONCURRENCY=2

# Both Django and the worker use BASE_DIR/db.sqlite3 through the same bind mount.
DRAFT_API_BASE_URL=https://coderun2026-csbwf4haa4d0gubu.westus3-01.azurewebsites.net
