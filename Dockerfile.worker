FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 celery
USER celery
CMD ["celery", "-A", "backend", "worker", "--loglevel=INFO", "--pool=prefork", "--concurrency=2"]
